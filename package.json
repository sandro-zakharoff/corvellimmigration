{
    "name": "corvell-immigration",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently --kill-others-on-fail --names client,server \"npm:dev:client\" \"npm:dev:server\"",
        "dev:client": "vite --host 127.0.0.1",
        "dev:server": "node --watch server/index.js",
        "build": "npm run check:content && vite build",
        "check:content": "node scripts/check-content.js",
        "preview": "vite preview --host 127.0.0.1",
        "start": "node server/index.js",
        "test": "node --test"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "dependencies": {
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "nodemailer": "^10.0.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-router-dom": "^7.18.3"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^5.0.0",
        "concurrently": "^10.0.5",
        "vite": "^7.0.4"
    }
}
